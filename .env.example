# Copy this file to `.env` in the same folder (project root) and fill in values.
# Restart `npx expo start` after changing .env so app.config.ts picks them up.
EXPO_PUBLIC_GEMINI_API_KEY = 
# Google Cloud / Firebase → OAuth 2.0 Client ID → type "Web application"
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Optional: Expo Auth proxy path for Google redirect (default is @anonymous/<slug>).
# Add this exact URL under the Web client → Authorized redirect URIs:
#   https://auth.expo.io/@anonymous/podcast-mvp
# If you use `expo login`, set to your real scope, e.g. @yourname/podcast-mvp
# EXPO_PUBLIC_EXPO_AUTH_PROXY_FULL_NAME=@yourname/podcast-mvp

